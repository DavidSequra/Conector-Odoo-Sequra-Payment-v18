<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_sequra" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.sequra</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'sequra'">
                    <field name="sequra_merchant_id" string="Merchant ID" required="code == 'sequra'"/>
                    <field name="sequra_api_key" string="API Key" required="code == 'sequra'"/>
                    <field name="sequra_secret_key" password="True" string="Secret Key" required="code == 'sequra'"/>
                    <field name="send_quotation"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
