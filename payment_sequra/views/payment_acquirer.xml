<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_sequra" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.sequra</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'sequra'">
                    <field name="sequra_merchant_id" string="Merchant ID" required="code == 'sequra'"/>
                    <field name="sequra_api_key" string="API Key" required="code == 'sequra'"/>
                    <field name="sequra_secret_key" password="True" string="Secret Key" required="code == 'sequra'"/>
                    <field name="send_quotation"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="transaction_form_sequra" model="ir.ui.view">
        <field name="name">payment.transaction.form.inherit.sequra</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="sequra_txn_id"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Sequra TX Details" invisible="provider_code != 'sequra'">
                    <group>
                        <field name="order_sequra_ref" readonly="1"/>
                        <field name="sequra_conf_resp_status_code"/>
                        <field name="sequra_conf_resp_reason"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
