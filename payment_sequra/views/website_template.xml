<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="payment_inherit" inherit_id="website_sale.payment">
            <xpath expr="//div[hasclass('oe_cart')]" position="before">
                <t t-raw="0"/>
            </xpath>
        </template>

        <template id="payment_sequra_form">
            <div t-att-class="submit_class">
                <div t-if="acquirer.state == 'test'" class="alert alert-info" role="alert">
                    <p>
                        <i class="fa fa-info-circle"/>
                        <b>Test Mode:</b> You are using Sequra in test mode.
                    </p>
                </div>
                <div t-raw="iframe" />
                <script type="text/javascript">
                    (function(){
                      window.SequraFormInstance.show();
                    })();
                </script>
            </div>
        </template>

        <template id="500">
            <t t-call="website.layout">
              <div id="wrap">
                <div class="container">
                    <h1 class="mt32">Error found!</h1>
                    <p class="alert alert-danger" t-if="error">
                        <t t-esc="error"/>
                    </p>
                </div>
              </div>
            </t>
        </template>
    </data>
</openerp>