<?xml version="1.0"?>
<odoo>
    <data>
        <!-- Add payment provider configuration to settings -->
        <record model="ir.ui.view" id="payment_sequra_config_settings">
            <field name="name">res.config.settings.inherit.payment.sequra</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="payment.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='payment_providers']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="module_payment_sequra"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="module_payment_sequra"/>
                            <div class="text-muted">
                                Accept payments with SeQura
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
