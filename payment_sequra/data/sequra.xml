<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Payment Method -->
        <record id="payment_method_sequra" model="payment.method">
            <field name="name">SeQura</field>
            <field name="code">sequra</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="image" type="base64" file="payment_sequra/static/src/img/sequra_icon.png"/>
        </record>

        <!-- Account Journal for SeQura -->
        <record id="account_journal_sequra" model="account.journal">
            <field name="name">SeQura Payments</field>
            <field name="code">SEQURA</field>
            <field name="type">bank</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="sequence">15</field>
        </record>

        <!-- Payment Provider -->
        <record id="payment_provider_sequra" model="payment.provider">
            <field name="name">SeQura</field>
            <field name="code">sequra</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="journal_id" ref="account_journal_sequra"/>
            <field name="state">enabled</field>
            <field name="is_published">True</field>
            <field name="payment_method_ids" eval="[(6, 0, [ref('payment_method_sequra')])]"/>
            <field name="sequra_merchant_id">test_merchant</field>
            <field name="sequra_api_key">test_api_key</field>
            <field name="sequra_secret_key">test_secret_key</field>
            <field name="send_quotation">True</field>
            <field name="available_currency_ids" eval="[(6, 0, [ref('base.EUR')])]"/>
            <field name="available_country_ids" eval="[(6, 0, [ref('base.es'), ref('base.it'), ref('base.fr'), ref('base.pt')])]"/>
        </record>
    </data>
</odoo>
